{
  "name": "ahnaf-portfolio",
  "version": "1.0.0",
  "description": "Ahnaf Rahat's Professional Portfolio",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss styles.css -o dist/styles.css",
    "build:js": "esbuild src/script.js --bundle --outfile=dist/script.js --minify",
    "db:create": "wrangler d1 create portfolio-db",
    "db:migrate": "wrangler d1 migrations apply portfolio-db",
    "db:local": "wrangler d1 execute portfolio-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241218.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0",
    "esbuild": "^0.19.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.1.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^6.0.0"
  },
  "keywords": ["portfolio", "cloudflare", "workers", "d1"],
  "author": "Ahnaf Rahat",
  "license": "MIT"
}
